# Configuration for the Distributed Food Delivery System

# --- Reducer Configuration ---
# Η διεύθυνση IP ή το hostname όπου τρέχει ο Reducer
reducer.host=127.0.0.1
# Η πόρτα στην οποία ακούει ο Reducer
reducer.port=7000

# --- Worker Configuration ---
# Καθορίστε κάθε worker με μοναδικό ID (ξεκινώντας από 0)
# worker.<id>=<ip_address>:<port_number>

# Παράδειγμα για 2 Workers που τρέχουν τοπικά (localhost)
worker.0=127.0.0.1:6000
worker.1=127.0.0.1:6001

# Προσθέστε περισσότερους workers αν χρειάζεται, π.χ.:
# worker.2=127.0.0.1:6002
# worker.3=192.168.1.105:6000 # Worker σε άλλο μηχάνημα
